    { "path": "examples/gdscript/typed_class.gd", "language": "gdscript", "tier": "complete", "verify": "parse" },
    { "path": "examples/gdscript/data_modeling.gd", "language": "gdscript", "tier": "complete", "verify": "parse" },
    { "path": "examples/gdscript/composition_vs_inheritance.gd", "language": "gdscript", "tier": "complete", "verify": "parse" },
